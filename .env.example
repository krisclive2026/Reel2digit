# --- App ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Postgres (self-hosted, via docker-compose "db" service) ---
POSTGRES_USER=reeltodigit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reeltodigit
# app.py builds DATABASE_URL from the above automatically inside docker-compose.
# If running app.py outside compose, set the full URL directly instead:
# DATABASE_URL=postgresql://reeltodigit:change-me@localhost:5432/reeltodigit

# --- MinIO (self-hosted, S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
S3_BUCKET_NAME=reeltodigit-media
# AWS_ENDPOINT_URL / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are set
# automatically by docker-compose.yml from the MinIO vars above.
# Leave AWS_ENDPOINT_URL unset if you ever want to point back at real AWS S3.
